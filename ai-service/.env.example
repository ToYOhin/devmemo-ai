# deterministic keeps local development and tests key-free.
AI_PROVIDER=deterministic
AI_EMBEDDING_PROVIDER=deterministic
AI_FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
AI_FASTEMBED_DIMENSION=384
AI_FASTEMBED_CACHE_DIR=
AI_INDEX_ON_WEBHOOK=false
AI_VECTOR_STORE=memory
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=devmemo_memos
QDRANT_API_KEY=

# OpenAI option
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama option
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://ollama:11434
